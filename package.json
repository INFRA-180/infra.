{
  "name": "infra-public-site",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "python3 -m http.server 8080 --directory public",
    "test": "node tools/release-audit.js",
    "audit:release": "node tools/release-audit.js",
    "check:boundary": "node tools/verify-public-boundary.js",
    "bump": "node tools/bump-version.js",
    "visual": "playwright test --config tools/visual/playwright.config.js",
    "visual:update": "playwright test --config tools/visual/playwright.config.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "wrangler": "4.127.1"
  }
}
